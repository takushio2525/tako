---
/**
 * 場面: タスクの中身を見る（行の直下に開く・添付の縮小とプレビュー・別の行へ移る・コピー用のテキスト）。4 手順。#2058
 * 事実の出どころ: .agent/requirements.md FR-2.40.11（詳細は縦 1 枚）/ 2.40.22（添付は行を押すとプレビュー）/
 * 2.40.23（画像の縮小）/ 2.40.25（アコーディオン・開くのは 1 件）/ FR-2.40.1（copy_texts は貼り先ごと）。
 * 文言: crates/tako-app/src/ui_text/panel.rs（tasks_attachments / tasks_copy_texts / tasks_copied）。
 */
import Scrolly from '../motion/Scrolly.astro';
import Step from '../motion/Step.astro';
import TakoWindow from '../motion/TakoWindow.astro';
import Split from '../motion/Split.astro';
import Pane from '../motion/Pane.astro';
import Pointer from '../motion/Pointer.astro';
import TasksPanel from '../motion/TasksPanel.astro';
import TasksHead from '../motion/TasksHead.astro';
import TaskRow from '../motion/TaskRow.astro';
import TaskAttachment from '../motion/TaskAttachment.astro';
import TaskCopyTexts from '../motion/TaskCopyTexts.astro';
---

<div class="tk-ut">
	<Scrolly label="タスクの中身を開いて見る流れ">
		<TakoWindow slot="stage" tabs={[{ label: 'my-app (AI チーム)', state: 'running', active: true }]} height={30} status={false}>
			<Split>
				<Pane n={1} title="マスター" badge="ORCH" state="running">
					<span class="tk-l tk-tui-msg">返答を待つ間に、テストを進めます</span>
					<span class="tk-l tk-dim">テスト 12 件中 9 件が通過</span>
				</Pane>
				<Pane n={2} title="login.png" state="none" at="2+" fx="split" body="flush">
					<div class="tk-ut-preview">
						<span class="tk-ut-shot"><i></i><i></i><i></i></span>
					</div>
				</Pane>
			</Split>
			<TasksPanel slot="right" width="56%" narrow="64%" counts={[{ n: 4 }]}>
				<TasksHead
					waiting={[{ n: 4 }]}
					kinds={['レビュー', '許可', '投稿']}
					notice={{ text: '「投稿文」をコピーしました', at: '4' }}
				/>
				<div class="tk-ut-list">
					<div class="tk-ut-scroller" data-at="4" data-fx="state" style="--to: -5em">
						<TaskRow id="u-6" kind="review" title="ログイン画面の見た目を確認" openAt="!3+">
							<div class="tk-ut-meta"><span class="tk-ut-kind">レビュー</span></div>
							<div class="tk-ut-md">ボタンの大きさと配置を見てください。</div>
							<div class="tk-ut-sec">添付</div>
							<TaskAttachment route="画像" name="shots/login.png" thumb pressAt="2" />
						</TaskRow>
						<TaskRow id="u-5" kind="post" title="リリースのお知らせを X へ投稿" openAt="3+">
							<div class="tk-ut-meta"><span class="tk-ut-kind">投稿</span><span class="tk-ut-due">期限 10/20</span></div>
							<div class="tk-ut-md">動画を見て問題なければ投稿してください。</div>
							<div class="tk-ut-sec">添付</div>
							<TaskAttachment route="動画" name="out/release.mp4" />
							<TaskCopyTexts labels={['投稿文', 'タグ']} press={{ label: '投稿文', at: '4' }} />
						</TaskRow>
						<TaskRow id="u-4" kind="review" title="API の設計メモを確認" />
						<TaskRow id="u-3" kind="permission" title="本番 DB のマイグレーションを許可" />
					</div>
				</div>
			</TasksPanel>
			<Pointer slot="overlay" path="2:70,85 3:70,58 4:49,88" click="2 3 4" />
		</TakoWindow>

		<Step title="押した行の、すぐ下に開く">
			<p>行を押すと、その行のすぐ下に中身が開きます。本文は Markdown のまま読めて、画像の添付には縮小が付きます。</p>
		</Step>
		<Step title="添付は、押すとプレビューで開く">
			<p>添付の行を押すと、tako のプレビューで開きます。行の左の「画像」「動画」などが、何で開くかの目印です。</p>
			<p>同じ添付を何度押しても、プレビューのペインは増えません。</p>
		</Step>
		<Step title="別の行を押すと、そちらへ移る">
			<p>開くのは常に 1 件だけです。別の行を押すと前の行は閉じ、押した行が開きます。開いている間も、ほかの行は一覧に残ります。</p>
		</Step>
		<Step title="コピー用のテキストは、貼り先ごとに">
			<p>投稿文・タイトル・タグのように貼り先が別々のものは、ボタンが 1 つずつ分かれています。押せばその 1 つだけがクリップボードに入ります。</p>
		</Step>
	</Scrolly>
</div>
