---
/**
 * かんたん表示（GUI モード）のスターターの全体（#2060）。空のペインがこれになる。GuiFrame の中に置く。
 * 既存の Starter 部品（3 枚のカードだけ）に、実物の下部の「初期設定をやり直す」と脚注、
 * 狭いペインでの間引き、押した印を足したもの。
 * 正本: crates/tako-app/src/starter.rs の render_starter_pane / ui_text/ui_mode.rs。
 *
 *   <GuiFrame><GuiStarter pressAt="2" /></GuiFrame>
 *
 * size（実物の間引きと同じ順）:
 *   full    = 全部
 *   compact = 実コマンドの併記と脚注を落とす（実物はペインの幅 420px 未満 / 高さ 260px 未満）
 *   tiny    = さらに見出しの補足・カードの説明・setup の行を落とす（幅 300px 未満 / 高さ 190px 未満）
 */
import Icon from './Icon.astro';
import '../../styles/tako-ui-chat.css';

interface Props {
	size?: 'full' | 'compact' | 'tiny';
	/** 「AI チームに任せる」が押された印を出す手順（data-at の書き方） */
	pressAt?: string;
}

const { size = 'full', pressAt } = Astro.props;
const cards = [
	{ icon: 'orch', title: 'AI チームに任せる', cmd: 'tako master', desc: '司令塔の AI が話を聞いて、必要なだけ担当 AI を集めて進めます', lead: true },
	{ icon: 'chat', title: 'AI と 1 対 1 で話す', cmd: 'tako solo', desc: '1 体の AI とじっくり相談したいときはこちら' },
	{ icon: 'terminal', title: 'コマンド入力へ', desc: 'この画面をターミナル表示に戻します（何も止まりません）' },
] as const;
---

<div class:list={['tk-gstarter', `is-${size}`]}>
	<span class="tk-starter-q">何をしますか？</span>
	<span class="tk-starter-sub tk-gstarter-sub">ボタンを押すと、この画面で AI が動き始めます</span>
	{
		cards.map((c) => (
			<span
				class:list={['tk-starter-card', { 'is-lead': 'lead' in c && c.lead }]}
				data-at={'lead' in c && c.lead ? pressAt : undefined}
				data-fx={'lead' in c && c.lead && pressAt ? 'mark' : undefined}
			>
				<span class="tk-starter-ic">
					<Icon name={c.icon} />
				</span>
				<span>
					<b>{c.title}</b>
					{'cmd' in c && <small class="tk-gstarter-cmd">{c.cmd}</small>}
				</span>
				<span class="tk-gstarter-desc">{c.desc}</span>
			</span>
		))
	}
	<span class="tk-gstarter-link">
		<Icon name="refresh" />
		初期設定をやり直す<small class="tk-gstarter-cmd">tako setup</small>
	</span>
	<span class="tk-gstarter-foot">これは表示の切り替えだけです。ターミナルはいつでも使えます</span>
</div>
