---
/**
 * コマンドカード（AI が `tako show-command` / MCP `tako_show_command` で出すカード）の再現。
 * 文言は crates/tako-app/src/ui_text/command_card.rs。
 *
 *   <CommandCard title="テストを実行する" command="npm run test" at="2+" ran="3+" />
 *
 * running / ran を渡すと、その手順でボタンの下に実行記録（実行中 → 実行済み（終了コード 0））が出る。
 * 実物はペインの下端の帯に出る（ターミナルが下から縮み、会話や入力欄に重ならない）。
 */
import Icon from './Icon.astro';

interface Props {
	title?: string;
	command: string;
	at?: string;
	fx?: string;
	/** 実行記録「実行中」を出す手順 */
	running?: string;
	/** 実行記録「実行済み（終了コード 0）」を出す手順 */
	ran?: string;
	class?: string;
}

const { title = '実行するコマンド', command, at, fx = 'pop', running, ran, class: className } = Astro.props;
---

<div class:list={['tk-cmdcard', className]} data-at={at} data-fx={at ? fx : undefined}>
	<div class="tk-cmdcard-head">
		<span>{title}</span>
		<Icon name="x" />
	</div>
	<div class="tk-cmdcard-box">
		<span class="tk-cmdcard-cmd">{command}</span>
		<div class="tk-cmdcard-actions">
			<span class="tk-ubtn"><Icon name="copy" />コピー</span>
			<span class="tk-ubtn"><Icon name="play" />新規ペインで実行</span>
		</div>
	</div>
	{
		(running || ran) && (
			<div class="tk-cmdcard-run tk-stack">
				{running && (
					<span data-at={running} data-fx="fade">
						<i class="tk-dot is-running" /> 実行中
					</span>
				)}
				{ran && (
					<span class="tk-ok" data-at={ran} data-fx="fade">
						実行済み（終了コード 0）
					</span>
				)}
			</div>
		)
	}
</div>
