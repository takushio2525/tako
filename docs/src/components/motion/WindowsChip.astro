---
/**
 * 機能 1 つ分の「どの OS で使えるか」の札（#2064）。見出しの直下に置く。
 *
 *   <WindowsChip tools={['tako_run']} expect="supported" />
 *   <WindowsChip tools={['tako_mod']} expect="pending" pending="実機での確認待ちです" />
 *
 * 状態は windows-support.md（生成ページ）からビルド時に読み、expect と食い違えばビルドを落とす。
 * 対応表で上がった / 下がったのに札と本文が古いまま、を止めるため（WindowsLimits と同じ考え方）。
 */
import { assertNotSupported, windowsSupport } from './windowsSupport';
import '../../styles/tako-more.css';

interface Props {
	/** 対応表の機能名（MCP ツール名）。どれか 1 つでも expect と違えばビルドを落とす */
	tools: string[];
	expect: 'supported' | 'pending';
	/** expect="pending" のときの Windows の一言（「Windows は」に続く） */
	pending?: string;
}

const { tools, expect, pending = 'まだ使えません' } = Astro.props;
const where = `WindowsChip（${tools.join(' / ')}）`;
if (expect === 'supported') {
	for (const tool of tools) {
		const status = windowsSupport.rows.get(tool);
		if (!status) throw new Error(`${where}: ${tool} は Windows 対応表に無い機能名です`);
		if (status !== '対応') {
			throw new Error(`${where}: ${tool} は Windows で「${status}」です。札と本文を「まだ」の書き方に直してください`);
		}
	}
} else {
	assertNotSupported(tools, where);
}
---

<p class:list={['tk-oschip', 'not-content', { 'is-pending': expect === 'pending' }]}>
	<span class="tk-oschip-os is-on">macOS</span>
	<span class:list={['tk-oschip-os', { 'is-on': expect === 'supported' }]}>Windows</span>
	<span class="tk-oschip-text">
		{expect === 'supported' ? 'どちらでも使えます' : `macOS で使えます。Windows は${pending}`}
	</span>
</p>
