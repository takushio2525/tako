---
/**
 * チャットビューの発話 1 つ（#2060）。吹き出し + 右のコピー列。ChatPane の中に置く。
 * 実物は自分の発話が右寄せの濃い吹き出し、AI の発話が左寄せの薄い枠。コピーのボタンは
 * 吹き出しの外の固定幅の列にあり（本文に被せない）、ふだんは淡く、ホバーとコピー直後だけ濃い。
 * 正本: crates/tako-app/src/chat_view.rs（FR-2.23.9 / 2.23.14 / 2.23.15）。
 *
 *   <ChatMsg role="user" at="2+" queuedAt="2-3">あとで README も直して</ChatMsg>
 *   <ChatMsg role="ai" at="3+" hoverAt="1" copiedAt="2">…</ChatMsg>
 *
 * - at を渡すと、その手順から高さ 0 → 開いて現れる（あとから積まれる発話）
 * - queuedAt: 生成中に送った指示の「送信待ち」を出す手順（届いたら消える）
 * - slot="gutter": コピー列に重ねるもの（コピーのボタンを指す Pointer など。座標はコピー列が基準）
 */
import Icon from './Icon.astro';
import '../../styles/tako-ui-chat.css';

interface Props {
	role: 'user' | 'ai';
	at?: string;
	/** コピーのボタンを出すか（本文の無い発話には実物も出さない） */
	copy?: boolean;
	/** ボタンが濃くなる（ポインターが乗っている）手順 */
	hoverAt?: string;
	/** 「コピーしました」を出す手順 */
	copiedAt?: string;
	queuedAt?: string;
}

const { role, at, copy = true, hoverAt, copiedAt, queuedAt } = Astro.props;
---

<div class="tk-gmsg-wrap" data-at={at} data-fx={at ? 'unfold' : undefined}>
	<div class:list={['tk-gmsg', role === 'user' ? 'is-user' : 'is-ai']}>
		<div class="tk-gmsg-bubble">
			<slot />
			{
				queuedAt && (
					<span class="tk-gmsg-queued" data-at={queuedAt} data-fx="unfold">
						<span>送信待ち</span>
					</span>
				)
			}
		</div>
		<span class="tk-gmsg-gutter">
			{
				copy && (
					<span class="tk-gcopy">
						<Icon name="copy" />
					</span>
				)
			}
			{
				copy && hoverAt && (
					<span class="tk-gcopy is-hover" data-at={hoverAt} data-fx="fade">
						<Icon name="copy" />
					</span>
				)
			}
			<slot name="gutter" />
			{
				copy && copiedAt && (
					<span class="tk-gcopy is-done" data-at={copiedAt} data-fx="pop">
						<Icon name="check" />
						コピーしました
					</span>
				)
			}
		</span>
	</div>
</div>
