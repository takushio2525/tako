{
  "title": "セットアップのアシスタント",
  "footer": "demo · アシスタントの台本（LLM は呼んでいません）",
  "promptLines": 2,
  "turns": [
    [
      { "busy": "現状を確認中" },
      { "wait": 900, "tool": "Read", "arg": "setup-instructions.md · setup-context.yaml" },
      { "exec": "cat setup-instructions.md setup-context.yaml > /dev/null" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "instruction_file", "field": "instruction_file" },
      { "wait": 500, "tool": "Read", "arg": "${instruction_file}" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "coverage", "field": "coverage" },
      { "wait": 500, "tool": "Read", "arg": "profiles/default.yaml · config.yaml · projects.yaml" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "agent", "field": "agent" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "plan", "field": "plan" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "master", "field": "master" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "worker", "field": "worker" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "model", "field": "model" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "effort", "field": "effort" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "policy", "field": "policy" },
      { "wait": 700, "say": "現状を読み込みました。初回のセットアップを、順に確かめます。", "color": "text", "beat": "read_done" },
      { "say": "" },
      { "wait": 1100, "say": "Step 1: グローバル指示ファイル", "color": "bold", "beat": "step1" },
      { "wait": 400, "say": "${instruction_file} は、${coverage}。", "indent": 2 },
      { "say": "" },
      { "wait": 1800, "say": "Step 2: オーケストレーション設定（プロファイル default）", "color": "bold", "beat": "step2" },
      { "wait": 500, "say": "セットアップ担当 = ${agent}。master = ${master} / worker = ${worker}", "indent": 2 },
      { "wait": 500, "say": "モデルは${model}（各 CLI の既定のモデルを使います）", "indent": 2 },
      { "wait": 500, "say": "effort = ${effort}・worker モデルは ${policy}（プラン ${plan} に合わせた推奨）", "indent": 2 },
      { "wait": 900, "say": "このまま使いますか？ 品質・速度・利用回数の重視点に合わせて調整もできます。", "indent": 2, "beat": "ask_orch" },
      { "say": "" }
    ],
    [
      { "busy": "検討中" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "worker_effort", "field": "worker_effort" },
      { "wait": 1200, "say": "利用回数を抑える案です（まだ変更していません）:", "color": "text" },
      { "wait": 400, "say": "worker（${worker}）の effort を ${worker_effort} → medium に下げる", "indent": 2 },
      { "wait": 400, "say": "master は ${effort} のまま（指示と検収の質は保ちます）", "indent": 2 },
      { "wait": 700, "say": "反映しますか？", "beat": "propose_orch" },
      { "say": "" }
    ],
    [
      { "busy": "反映中" },
      { "wait": 700, "tool": "Bash", "arg": "tako orchestrator profiles set default --agent ${worker} --agent-effort medium" },
      { "exec": "tako orchestrator profiles set default --agent ${worker} --agent-effort medium" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "worker_effort", "field": "worker_effort" },
      { "wait": 700, "say": "反映しました: worker（${worker}）の effort = ${worker_effort}・master は ${effort} のまま", "color": "ok", "beat": "orch_done" },
      { "say": "" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "projects", "field": "projects" },
      { "wait": 1600, "say": "Step 3: プロジェクト登録", "color": "bold", "beat": "step3" },
      { "wait": 500, "say": "登録済みのプロジェクトは ${projects} 件です。開発するフォルダを登録しますか？", "indent": 2 },
      { "wait": 400, "say": "（任意です。あとから master に頼んでも登録できます）", "color": "dim", "indent": 2, "beat": "ask_project" },
      { "say": "" }
    ],
    [
      { "busy": "登録中" },
      { "wait": 800, "tool": "Bash", "arg": "tako orchestrator projects add --key shop-app --cwd ~/shop-app" },
      { "exec": "tako orchestrator projects add --key shop-app --cwd \"$HOME/shop-app\"" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "project_key", "field": "project_key" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "project_dir", "field": "project_dir" },
      { "wait": 700, "say": "登録しました: ${project_key}（${project_dir}）", "color": "ok", "beat": "project_done" },
      { "say": "" },
      { "wait": 1600, "say": "Step 3.5: 設定共有（任意）", "color": "bold", "beat": "step35" },
      { "wait": 500, "say": "別の PC でも、同じ AI 設定で始められます。指示ファイルと tako の設定", "indent": 2 },
      { "say": "（プロファイル・プロジェクト）を、git リポジトリ 1 本で共有する仕組みです。", "indent": 2 },
      { "wait": 500, "say": "token などの秘匿情報と、この PC 固有の状態は共有の対象から外れます。", "indent": 2 },
      { "wait": 900, "say": "GitHub に private リポジトリを作って配線しますか？ 名前の案: tako-config-sync", "indent": 2, "beat": "ask_share" },
      { "say": "" }
    ],
    [
      { "busy": "配線中" },
      { "wait": 900, "say": "実行します: GitHub に private リポジトリ tako-config-sync を作り、設定を push します。", "color": "text" },
      { "wait": 800, "tool": "Bash", "arg": "gh repo create tako-config-sync --private" },
      { "exec": "printf '{\"url\":\"%s\" }' \"$(gh repo create tako-config-sync --private)\"", "capture": "url", "field": "url" },
      { "wait": 900, "tool": "Bash", "arg": "tako config init --remote ${url}", "beat": "gh_done" },
      { "exec": "tako config init --remote \"${url}\"" },
      { "wait": 700, "tool": "Bash", "arg": "tako config status", "beat": "init_done" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "share_repo", "field": "share_repo" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "share_remote", "field": "share_remote" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "share_files", "field": "share_files" },
      { "exec": "node \"$DEMO_FACTS\"", "capture": "share_differs", "field": "share_differs" },
      { "wait": 800, "say": "配線しました: ${share_repo} → ${share_remote}", "color": "ok", "beat": "share_done" },
      { "say": "共有 ${share_files} ファイル・差分 ${share_differs} 件。2 台目は tako config link <URL> → tako config pull", "indent": 2 },
      { "say": "" },
      { "wait": 2600, "say": "Step 4: 完了サマリー", "color": "bold", "beat": "step4" },
      { "wait": 400, "say": "変更: profiles/default.yaml（worker の effort）・projects.yaml・設定共有の配線", "indent": 2 },
      { "wait": 400, "say": "tako master  司令塔を起動。やってほしいことを日本語で話しかけるだけです", "indent": 2 },
      { "wait": 300, "say": "tako solo    worker を使わない 1 対 1 の対話", "indent": 2 },
      { "wait": 400, "say": "プロファイル default: master=${master} / worker=${worker} / effort=${effort}（worker は ${worker_effort}）", "indent": 2 },
      { "wait": 400, "say": "品質重視・節約などの調整は、master に頼めば変えられます。", "indent": 2, "beat": "summary" }
    ],
    [
      { "exec": "kill -TERM $PPID" }
    ]
  ]
}
