{
  "title": "司令塔（master）",
  "footer": "demo · 司令塔の台本（LLM は呼んでいません）",
  "promptLines": 2,
  "greeting": [
    "やってほしいことを、日本語で書いてください。"
  ],
  "turns": [
    [
      {
        "busy": "登録中"
      },
      {
        "wait": 1000,
        "say": "プロジェクトとして登録します。",
        "color": "text"
      },
      {
        "wait": 800,
        "tool": "add",
        "arg": "shop-app  ~/shop-app"
      },
      {
        "exec": "tako orchestrator projects add --key shop-app --cwd \"$HOME/shop-app\" --description 'デモ用のショップ API'",
        "code": "added"
      },
      {
        "wait": 900,
        "say": "登録しました: shop-app（~/shop-app）",
        "color": "ok",
        "beat": "project_done"
      },
      {
        "say": "以後の依頼は、担当（worker）を立てて進めます。",
        "color": "dim",
        "indent": 2
      }
    ],
    [
      {
        "busy": "分解中"
      },
      {
        "wait": 1100,
        "say": "成果物ごとに 2 つへ分けて、担当を立てます。",
        "color": "text",
        "beat": "plan"
      },
      {
        "wait": 900,
        "tool": "spawn",
        "arg": "api   決済 API にリトライ"
      },
      {
        "exec": "tako orchestrator spawn --project shop-app --label api --prompt '決済 API にリトライを入れる（最大 3 回・テスト緑まで）'",
        "capture": "api",
        "field": "pane_id",
        "beat": "spawn_api"
      },
      {
        "wait": 1100,
        "tool": "spawn",
        "arg": "docs  README を更新"
      },
      {
        "exec": "tako orchestrator spawn --project shop-app --label docs --prompt 'README に使い方を追記する（例が動くこと）'",
        "capture": "docs",
        "field": "pane_id",
        "beat": "spawn_docs"
      },
      {
        "wait": 900,
        "say": "右パネルに全体を出します。",
        "color": "text"
      },
      {
        "exec": "tako panel --show --view orch --width 300",
        "beat": "panel"
      },
      {
        "busy": "2 体を監視中"
      },
      {
        "waitBeat": "docs:prompt1"
      },
      {
        "wait": 500
      },
      {
        "until": "tako orchestrator status --pane ${docs}",
        "field": "status",
        "equals": "idle"
      },
      {
        "say": "docs  完了を検知 → 例とリンクを確認",
        "color": "ok",
        "indent": 2,
        "beat": "done_docs"
      },
      {
        "waitBeat": "api:prompt1"
      },
      {
        "wait": 500
      },
      {
        "until": "tako orchestrator status --pane ${api}",
        "field": "status",
        "equals": "idle"
      },
      {
        "say": "api   完了を検知 → テスト 12 件 緑",
        "color": "ok",
        "indent": 2,
        "beat": "done_api"
      },
      {
        "wait": 1000,
        "say": ""
      },
      {
        "say": "確かめました。2 件とも受け入れ条件を満たしています。",
        "color": "text",
        "beat": "report"
      },
      {
        "say": "変更 5 ファイル · テスト 12 件 緑 · README 更新済み",
        "color": "dim",
        "indent": 2
      }
    ]
  ]
}
